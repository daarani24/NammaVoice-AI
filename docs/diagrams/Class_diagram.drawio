        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class AuthRouter {\n    +POST /auth/register\n    +POST /auth/login\n  }\n  class ComplaintRouter {\n    +POST /complaints\n    +GET /complaints/my\n    +POST /complaints/id/evidence\n    +PATCH /complaints/id/verify\n  }\n  class OfficerRouter {\n    +GET /officer/pool\n    +POST /officer/id/accept\n    +PATCH /officer/id/status\n  }\n  class CollectorRouter {\n    +GET /collector/dashboard\n  }\n  class AdminRouter {\n    +GET /admin/users\n  }\n\n  class AuthService {\n    +register_user()\n    +login_user()\n  }\n  class ComplaintService {\n    +submit_complaint()\n    +accept_complaint()\n    +change_status()\n    +upload_complaint_evidence()\n    +verify_and_close()\n  }\n  class CollectorService {\n    +get_dashboard()\n  }\n  class AdminService {\n    +list_all_users()\n  }\n\n  class UserRepository {\n    +get_user_by_email()\n    +create_user()\n  }\n  class ComplaintRepository {\n    +create_complaint()\n    +assign_officer()\n    +get_district_stats()\n  }\n  class StatusHistoryRepository {\n    +add_status_entry()\n  }\n  class EvidenceRepository {\n    +add_evidence()\n  }\n  class CloudStorage {\n    +upload_image()\n  }\n\n  class UserModel\n  class ComplaintModel\n  class ComplaintStatusHistoryModel\n  class ComplaintEvidenceModel\n\n  AuthRouter --&gt; AuthService\n  ComplaintRouter --&gt; ComplaintService\n  OfficerRouter --&gt; ComplaintService\n  CollectorRouter --&gt; CollectorService\n  AdminRouter --&gt; AdminService\n\n  AuthService --&gt; UserRepository\n  ComplaintService --&gt; ComplaintRepository\n  ComplaintService --&gt; StatusHistoryRepository\n  ComplaintService --&gt; EvidenceRepository\n  ComplaintService --&gt; CloudStorage\n  CollectorService --&gt; ComplaintRepository\n  AdminService --&gt; UserRepository\n\n  UserRepository --&gt; UserModel\n  ComplaintRepository --&gt; ComplaintModel\n  StatusHistoryRepository --&gt; ComplaintStatusHistoryModel\n  EvidenceRepository --&gt; ComplaintEvidenceModel&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="YJeEMID5jr6j-T_qEhU0-1">
